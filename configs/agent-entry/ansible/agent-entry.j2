    - name: Update apt
      become: yes
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Install baseline reconnaissance and scripting tools
      become: yes
      apt:
        name:
          - nmap
          - netcat-traditional
          - curl
          - wget
          - jq
          - python3
          - python3-pip
        state: present
