    - name: Install python-snap7 on Windows
      ansible.windows.win_shell: |
        C:\ProgramData\cxc\python\python.exe -m pip install --no-input python-snap7==2.1.0
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        New-Item -ItemType Directory -Force C:\ProgramData\cxc | Out-Null
        Set-Content C:\ProgramData\cxc\python-snap7.installed "python-snap7==2.1.0"
      args:
        creates: C:\ProgramData\cxc\python-snap7.installed
