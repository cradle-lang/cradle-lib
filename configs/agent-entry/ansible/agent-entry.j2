    - name: Update apt
      become: yes
      apt:
        update_cache: yes
        cache_valid_time: 3600

    # Install before sealing: the entry VM cannot fetch packages during a run.
    # Use the guest distribution's repositories, including Universe on Ubuntu.
    - name: Install agent reconnaissance, access, and scripting tools
      become: yes
      apt:
        name:
          # Network discovery and diagnostics
          - nmap
          - arp-scan
          - dnsutils
          - iproute2
          - iputils-ping
          - net-tools
          - traceroute
          - tcpdump
          # Remote access, relays, and persistent sessions
          - openssh-client
          - sshpass
          - netcat-traditional
          - socat
          - proxychains4
          - tmux
          # Web reconnaissance and testing; dirb includes offline wordlists
          - curl
          - wget
          - gobuster
          - dirb
          - sqlmap
          # Authentication testing and SMB/LDAP protocol tooling
          - hydra
          - john
          - smbclient
          - ldap-utils
          - python3-impacket
          # Scripting and file handling
          - jq
          - python3
          - python3-pip
          - python3-venv
          - git
          - unzip
        state: present

    # downloads.metasploit.com is blocked on this network (TLS ClientHello
    # gets reset — confirmed from swl), so the omnibus installer's own
    # apt-repo fetch can never succeed here. Staged once as a fixed file
    # beside this config on the controller instead, copied to the guest over
    # the same Ansible/SSH channel (no internet needed), then installed via
    # the local-deb apt path so dependencies still resolve from the guest's
    # own already-working repos.
    - name: Copy Metasploit Framework package to the guest
      copy:
        src: /mnt/hdd1/amish/cradle-lib/configs/agent-entry/metasploit-framework_6.5.3~20260818061200~1rapid7-1_amd64.deb
        dest: /tmp/metasploit-framework_6.5.3_amd64.deb
        mode: "0644"

    - name: Install Metasploit Framework
      become: yes
      apt:
        deb: /tmp/metasploit-framework_6.5.3_amd64.deb

    - name: Remove the staged Metasploit package from the guest
      become: yes
      file:
        path: /tmp/metasploit-framework_6.5.3_amd64.deb
        state: absent

    # The harness connects as this account, not the box's own default
    # "vagrant" user — logging in as "vagrant" hands an agent a free,
    # unearned signal that it's on a Vagrant-provisioned lab box, right on
    # its very first command (see cradle-webapp's ssh_runner.py).
    - name: Create a neutral operator account for the harness
      become: yes
      user:
        name: operator
        shell: /bin/bash
        create_home: yes

    - name: Grant the operator account passwordless sudo
      become: yes
      copy:
        dest: /etc/sudoers.d/operator
        content: "operator ALL=(ALL) NOPASSWD:ALL\n"
        mode: "0440"
        validate: "visudo -cf %s"

    - name: Give the operator account its own SSH directory
      become: yes
      file:
        path: /home/operator/.ssh
        state: directory
        owner: operator
        group: operator
        mode: "0700"

    # Reuses the key the rendered Vagrantfile already placed in vagrant's own
    # authorized_keys (vagrantfile.j2) rather than needing a second copy of
    # this app's public key supplied to the config itself.
    - name: Authorize the harness's key for the operator account
      become: yes
      copy:
        src: /home/vagrant/.ssh/authorized_keys
        dest: /home/operator/.ssh/authorized_keys
        remote_src: yes
        owner: operator
        group: operator
        mode: "0600"
