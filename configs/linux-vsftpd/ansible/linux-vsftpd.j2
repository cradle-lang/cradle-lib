    - name: Install vsftpd
      become: yes
      apt:
        name: vsftpd
        state: present

    - name: Configure vsftpd
      become: yes
      copy:
        dest: /etc/vsftpd.conf
        content: |
          listen=NO
          listen_ipv6=YES
          anonymous_enable=NO
          local_enable=YES
          write_enable=YES
          dirmessage_enable=YES
          use_localtime=YES
          xferlog_enable=YES
          connect_from_port_20=YES
          secure_chroot_dir=/var/run/vsftpd/empty
          pam_service_name=vsftpd
          rsa_cert_file=/etc/ssl/certs/ssl-cert-snakeoil.pem
          rsa_private_key_file=/etc/ssl/private/ssl-cert-snakeoil.key
          ssl_enable=NO

    - name: Create FTP root directory
      become: yes
      file:
        path: /srv/ftp
        state: directory
        owner: ftp
        group: nogroup
        mode: "0755"

    - name: Create FTP upload directory
      become: yes
      file:
        path: /srv/ftp/upload
        state: directory
        owner: ftp
        group: nogroup
        mode: "0777"

    - name: Restart vsftpd
      become: yes
      service:
        name: vsftpd
        state: restarted
        enabled: yes
