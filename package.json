{
  "name": "cradle-ttp-library",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "library:new": "node scripts/library-command.mjs new",
    "library:describe": "node scripts/library-command.mjs describe",
    "library:check": "node scripts/export-ttps.mjs --check && node scripts/export-configs.mjs --check",
    "library:export-website": "node scripts/export-ttps.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run docs:check && npm run library:check && node scripts/check-configs.mjs && npm test",
    "library:export-configurations": "node scripts/export-configs.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "markdownlint": "^0.38.0"
  }
}
