    - name: Install pyModbusTCP on Windows
      ansible.windows.win_shell: |
        C:\ProgramData\cxc\python\python.exe -m pip install --no-input pyModbusTCP==0.2.0
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        New-Item -ItemType Directory -Force C:\ProgramData\cxc | Out-Null
        Set-Content C:\ProgramData\cxc\python-modbus-tcp.installed "pyModbusTCP==0.2.0"
      args:
        creates: C:\ProgramData\cxc\python-modbus-tcp.installed
